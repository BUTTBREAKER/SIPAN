{
    "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
    "assist": {
        "actions": {
            "source": {
                "noDuplicateClasses": "on",
                "organizeImports": "on",
                "useSortedAttributes": "on",
                "useSortedEnumMembers": "on",
                "useSortedInterfaceMembers": "on",
                "useSortedKeys": "on",
                "useSortedPackageJson": "off",
                "useSortedProperties": "on",
                "useSortedSelectionSet": "on",
                "useSortedTypeFields": "on"
            }
        }
    },
    "css": {
        "assist": { "enabled": true },
        "formatter": { "quoteStyle": "single" },
        "globals": [],
        "linter": { "enabled": true },
        "parser": {
            "allowWrongLineComments": false,
            "cssModules": true,
            "tailwindDirectives": true
        }
    },
    "extends": [],
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!public/assets/js/driver.js.iife.js"],
        "maxSize": null
    },
    "formatter": {
        "attributePosition": "auto",
        "bracketSameLine": true,
        "bracketSpacing": true,
        "delimiterSpacing": false,
        "expand": "auto",
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 80,
        "trailingNewline": true,
        "useEditorconfig": true
    },
    "html": {
        "formatter": {
            "enabled": true,
            "indentScriptAndStyle": true,
            "selfCloseVoidElements": "never",
            "whitespaceSensitivity": "ignore"
        }
    },
    "javascript": {
        "assist": { "enabled": true },
        "formatter": {
            "arrowParentheses": "asNeeded",
            "operatorLinebreak": "after",
            "quoteProperties": "asNeeded",
            "quoteStyle": "single",
            "semicolons": "asNeeded",
            "trailingCommas": "all"
        },
        "globals": [],
        "linter": { "enabled": true },
        "parser": { "unsafeParameterDecoratorsEnabled": false }
    },
    "json": {
        "assist": { "enabled": true },
        "formatter": { "trailingCommas": "none" },
        "linter": { "enabled": true },
        "parser": { "allowComments": false, "allowTrailingCommas": false }
    },
    "linter": { "domains": {}, "enabled": true, "rules": {} },
    "overrides": [],
    "plugins": [],
    "root": true,
    "vcs": {
        "clientKind": "git",
        "defaultBranch": "main",
        "enabled": true,
        "root": null,
        "useIgnoreFile": true
    }
}
