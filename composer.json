{
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "audit": {
            "ignore": ["firebase/php-jwt"]
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "require": {
        "ext-json": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "6.10.0",
        "flightphp/container": "^1.3",
        "guzzlehttp/psr7": "^2.13",
        "leafs/session": "^4.0",
        "mpdf/mpdf": "^8.3",
        "php": ">=8.0",
        "phpoffice/phpspreadsheet": "^1.30",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/dotenv": "^5.4",
        "symfony/polyfill-php81": "^1.38",
        "symfony/polyfill-php82": "^1.38",
        "symfony/polyfill-php83": "^1.41",
        "symfony/polyfill-php84": "^1.38",
        "symfony/polyfill-php85": "^1.41"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/var-dumper": "^6.0"
    },
    "scripts": {
        "format": ["phpcbf"],
        "lint": ["phpstan --memory-limit=1G"],
        "post-autoload-dump": "php -r \"if (!file_exists('.env')) copy('.env.example', '.env');\"",
        "serve": "php -S localhost:61001 -t public"
    }
}
