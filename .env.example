# Configuración de la aplicación
app_env=development
app_debug=true

# Configuración de la sesión
session_lifetime=86400 # 1 día
session_name=SIPAN_SESSION

# Configuración de Base de Datos
db_driver=mysql
db_host=localhost
db_name=sipan
db_user=root
db_pass=

# Configuración de JWT
jwt_secret=sipan_secret_key_2024

# Configuración de Rate Limiting
rate_limit_login_max_attempts=5
rate_limit_login_window=300 # 5 segundos

# Configuración de pruebas
INTEGER_ENV_VARIABLE=123
FLOAT_ENV_VARIABLE=1.23
BOOLEAN_ENV_VARIABLE=true
